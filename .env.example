# Copy to .env and fill in (Supabase Dashboard -> Project Settings -> API Keys)
# Only the publishable key belongs here. The secret key lives in Programming-Benchmark/.env
# (NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY also work)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
